diff --git a/ankigarden/ui/garden_recap.py b/ankigarden/ui/garden_recap.py
new file mode 100644
index 0000000..0dd7cb1
--- /dev/null
+++ b/ankigarden/ui/garden_recap.py
@@ -0,0 +1,348 @@
+"""Private, local keepsake export; never owns or advances gameplay state."""
+
+from __future__ import annotations
+
+import logging
+from copy import deepcopy
+from dataclasses import dataclass
+from datetime import date
+from pathlib import Path
+from typing import Any
+
+from aqt.qt import (
+    QApplication, QDialog, QFileDialog, QFont, QImage, QIODevice, QLabel,
+    QObject, QPainter, QPainterPath, QPen, QPushButton, QRectF, QSaveFile,
+    QStandardPaths, QTimer, Qt, QColor,
+)
+
+from .landmark_display import project_landmark_artwork_rect
+from .plant_display import GARDEN_CANVAS_HEIGHT, GARDEN_CANVAS_WIDTH
+from .scene import GardenSceneWidget
+
+
+logger = logging.getLogger(__name__)
+
+
+@dataclass(frozen=True)
+class _RecapStyle:
+    size: tuple[int, int] = (1800, 1200)
+    heading: tuple[int, int, int, int] = (64, 40, 1672, 84)
+    subtitle: tuple[int, int, int, int] = (64, 132, 1672, 42)
+    viewport: tuple[int, int, int, int] = (64, 206, 1672, 900)
+    footer: tuple[int, int, int, int] = (64, 1132, 1672, 30)
+    text_sizes: tuple[int, int, int] = (70, 32, 24)
+    paper: str = "#F6F3EB"
+    ink: tuple[str, str, str] = ("#284438", "#647266", "#66746A")
+    border: str = "#D9DED3"
+    corner_radius: int = 24
+
+
+_STYLE = _RecapStyle()
+
+
+@dataclass(frozen=True)
+class _RecapContext:
+    exported_on: date
+    scene: dict[str, Any]
+
+    @property
+    def filename(self) -> str:
+        return f"anki-garden-recap-{self.exported_on.year}.png"
+
+    @property
+    def subtitle(self) -> str:
+        return f"{self.exported_on.year} Year in Review"
+
+
+def _capture_recap_context(engine: Any, exported_on: date | None = None) -> _RecapContext:
+    """Copy only committed artwork inputs, without UI selectors or history reads."""
+    exported_on = exported_on or date.today()
+    state = engine.state
+
+    def asset(method: str, *args: Any) -> Any:
+        # These existing resolvers read the local registry; they do not fetch,
+        # reroll, equip, initialize gameplay, or persist asset choices.
+        resolved = getattr(engine, method)(*args)
+        return deepcopy(resolved.to_payload()) if resolved is not None else None
+
+    landmark = asset("resolve_landmark_asset")
+    scene = {
+        "theme": str(engine.config.value("visual_theme", "verdant_twilight")),
+        "scenery": state.selected_background,
+        "visible_scenery": state.selected_background,
+        "garden_feature": state.displayed_garden_feature,
+        "garden_feature_visible": True,
+        "unlocked_slots": state.unlocked_slots,
+        "landmark_id": state.garden_project.displayed_project_id if landmark else "",
+        "show_status_overlay": False,
+        "show_locked_bed_badges": False,
+        "motion_enabled": False,
+        "stage_transitions": [],
+        "asset_paths": {
+            "background": asset("resolve_background_asset"),
+            "garden_feature": asset("resolve_garden_feature_asset"),
+            "garden_overlay": asset("resolve_garden_overlay_asset"),
+            "landmark": landmark,
+        },
+        "plants": [
+            {
+                # Ephemeral identities suffice for the renderer. Personal
+                # names, persistent IDs, counters and memories never enter it.
+                "plant_id": f"bed-{plant.slot_index}",
+                "slot_index": plant.slot_index,
+                "species": plant.species,
+                "stage": plant.growth_stage,
+                "asset": asset("resolve_plant_asset", plant.species, plant.growth_stage),
+            }
+            for plant in state.plants if plant.slot_index is not None
+        ],
+    }
+    return _RecapContext(exported_on, deepcopy(scene))
+
+
+def _artwork_bounds(snapshot: GardenSceneWidget) -> QRectF:
+    """Contain the design canvas plus silhouettes, protecting rounded corners."""
+    bounds = snapshot._garden_canvas_rect()
+    artwork: list[QRectF] = []
+    for _plant, layout in snapshot._layout_plants(snapshot.width(), snapshot.height()):
+        visible = layout.visible
+        artwork.append(QRectF(visible.x, visible.y, visible.width, visible.height))
+    decoration = snapshot.decoration_visible_geometry()
+    if decoration is not None:
+        artwork.append(decoration)
+    if snapshot.scene.get("landmark_id"):
+        artwork.append(QRectF(*project_landmark_artwork_rect(
+            bounds.x(), bounds.y(), bounds.width(), bounds.height(),
+            snapshot.scene["landmark_id"],
+        )))
+    for rect in artwork:
+        # No margin is added where the authored scene already has clearance.
+        pad = _STYLE.corner_radius
+        bounds = bounds.united(rect.adjusted(-pad, -pad, pad, pad))
+    return bounds
+
+
+def _render_recap(context: _RecapContext) -> QImage:
+    """GUI-thread painting from source assets into fixed physical pixel buffers."""
+    snapshot = GardenSceneWidget(interactive=False)
+    painter: QPainter | None = None
+    try:
+        snapshot.resize(int(GARDEN_CANVAS_WIDTH), int(GARDEN_CANVAS_HEIGHT))
+        # This instance is never shown, parented into the live page, or focused.
+        snapshot.set_scene(deepcopy(context.scene))
+        bounds = _artwork_bounds(snapshot)
+        viewport = QRectF(*_STYLE.viewport)
+        scene_image = QImage(int(viewport.width()), int(viewport.height()), QImage.Format.Format_RGB32)
+        source_path, *_ = snapshot._surface_asset_record(snapshot.width(), snapshot.height())
+        if not source_path:
+            source_path, _ = snapshot._asset_record("background")
+        source = snapshot._pixmap_for(source_path) if source_path else None
+        if source is None:
+            raise RuntimeError("Garden background unavailable")
+        # The current renderer contains a fixed 3:2 scene and cannot extend
+        # background-only artwork. Use a quiet color sampled from that scenery.
+        source_image = source.toImage()
+        edges = [source_image.copy(x, 0, 1, source.height()).scaled(
+            1, 1, Qt.AspectRatioMode.IgnoreAspectRatio,
+            Qt.TransformationMode.SmoothTransformation,
+        ).pixelColor(0, 0) for x in (0, source.width() - 1)]
+        matte = QColor(*[sum(getattr(edge, channel)() for edge in edges) // len(edges)
+                         for channel in ("red", "green", "blue")])
+        scene_image.fill(matte)
+        scale = min(viewport.width() / bounds.width(), viewport.height() / bounds.height())
+        painter = QPainter(scene_image)
+        painter.translate(
+            (viewport.width() - bounds.width() * scale) / 2,
+            (viewport.height() - bounds.height() * scale) / 2,
+        )
+        painter.scale(scale, scale)
+        painter.translate(-bounds.x(), -bounds.y())
+        snapshot._paint_scene(painter, artwork_only=True, artwork_bounds=bounds)
+        painter.end()
+
+        image = QImage(*_STYLE.size, QImage.Format.Format_RGB32)
+        image.fill(QColor(_STYLE.paper))
+        painter = QPainter(image)
+        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
+        clip = QPainterPath()
+        clip.addRoundedRect(viewport, _STYLE.corner_radius, _STYLE.corner_radius)
+        painter.save()
+        painter.setClipPath(clip)
+        painter.drawImage(viewport.topLeft(), scene_image)
+        painter.restore()
+        painter.setPen(QPen(QColor(_STYLE.border), 1))
+        painter.setBrush(Qt.BrushStyle.NoBrush)
+        painter.drawPath(clip)
+        for index, (text, box) in enumerate((
+            ("Anki Garden Recap", _STYLE.heading),
+            (context.subtitle, _STYLE.subtitle),
+            ("Anki Garden", _STYLE.footer),
+        )):
+            font = QFont(QApplication.font())
+            font.setPixelSize(_STYLE.text_sizes[index])
+            font.setWeight(QFont.Weight.DemiBold if index == 0 else QFont.Weight.Normal)
+            painter.setFont(font)
+            painter.setPen(QColor(_STYLE.ink[index]))
+            painter.drawText(QRectF(*box), Qt.AlignmentFlag.AlignCenter, text)
+        painter.end()
+        return image
+    finally:
+        if painter is not None and painter.isActive():
+            painter.end()
+        snapshot.timer.stop()
+        snapshot.clear_render_caches()
+        snapshot.deleteLater()
+
+
+def _write_recap(image: QImage, destination: str) -> None:
+    """Encode off the GUI thread; never truncate an existing destination."""
+    output = QSaveFile(destination)
+    output.setDirectWriteFallback(False)
+    try:
+        if not output.open(QIODevice.OpenModeFlag.WriteOnly):
+            raise OSError("Could not create temporary output")
+        if not image.save(output, "PNG"):
+            raise OSError("Could not encode image")
+        if not output.commit():
+            raise OSError("Could not commit image")
+    finally:
+        if output.isOpen():
+            output.cancelWriting()
+
+
+class _GardenRecapExport(QObject):
+    def __init__(self, dashboard: Any, action: Any) -> None:
+        super().__init__(dashboard)
+        self._dashboard = dashboard
+        self._action = action
+        self._context: _RecapContext | None = None
+        self._image: QImage | None = None
+        self._destination = ""
+        self._busy = False
+        self._disposed = False
+        self._render_timer = QTimer(self)
+        self._render_timer.setSingleShot(True)
+        self._render_timer.timeout.connect(self._render_and_write)
+        self._retry_timer = QTimer(self)
+        self._retry_timer.setSingleShot(True)
+        self._retry_timer.timeout.connect(self._choose_destination)
+        dashboard.destroyed.connect(self._dispose)
+        action.triggered.connect(self.start)
+
+    def start(self) -> None:
+        if self._busy or self._disposed:
+            return
+        self._busy = True
+        self._action.setEnabled(False)
+        try:
+            self._context = _capture_recap_context(self._dashboard.engine)
+            self._destination = self._context.filename
+            self._choose_destination()
+        except Exception:
+            logger.exception("Anki Garden: recap snapshot failed")
+            self._failure()
+
+    def _choose_destination(self) -> None:
+        dialog = QFileDialog(self._dashboard, "Save garden recap")
+        try:
+            dialog.setAcceptMode(QFileDialog.AcceptMode.AcceptSave)
+            dialog.setFileMode(QFileDialog.FileMode.AnyFile)
+            dialog.setNameFilter("PNG image (*.png)")
+            dialog.setDefaultSuffix("png")
+            destination = Path(self._destination)
+            dialog.setDirectory(str(destination.parent) if destination.is_absolute() else
+                                QStandardPaths.writableLocation(QStandardPaths.StandardLocation.DocumentsLocation))
+            dialog.selectFile(destination.name)
+            while True:
+                if dialog.exec() != QDialog.DialogCode.Accepted:
+                    self._finish()
+                    return
+                chosen = dialog.selectedFiles()[0]
+                if chosen.lower().endswith(".png"):
+                    break
+                # Reconfirm the actual PNG destination, including overwrite,
+                # on platforms that allow typing an unrelated suffix.
+                dialog.selectFile(chosen + ".png")
+            self._destination = chosen
+        finally:
+            dialog.deleteLater()
+        self._dashboard.toast_region.show_message("Saving garden recap…")
+        self._render_timer.start(0)
+
+    def _render_and_write(self) -> None:
+        try:
+            if self._image is None:
+                if self._context is None:
+                    raise RuntimeError("No recap snapshot")
+                self._image = _render_recap(self._context)
+            # Only the detached image and filename cross the thread boundary.
+            image, destination = self._image, self._destination
+            self._dashboard.mw_window.taskman.run_in_background(
+                lambda: _write_recap(image, destination), self._written,
+            )
+        except Exception:
+            logger.exception("Anki Garden: recap rendering failed")
+            self._failure()
+
+    def _written(self, future: Any) -> None:
+        if self._disposed:
+            return
+        try:
+            future.result()
+        except Exception:
+            logger.exception("Anki Garden: recap writing failed")
+            self._failure()
+        else:
+            self._finish()
+            self._dashboard.toast_region.show_message("Garden recap saved.")
+
+    def _failure(self) -> None:
+        from .dashboard import GardenDialog, _set_button_variant
+        from .dialog_foundations import DialogSizeClass
+        from .theme import ControlVariant
+
+        dialog = GardenDialog(self._dashboard, "Couldn’t save garden recap")
+        try:
+            dialog.apply_size_policy(DialogSizeClass.TRANSACTION)
+            message = QLabel("The image could not be saved. Try again or choose another location.", dialog)
+            message.setWordWrap(True)
+            dialog.body_layout.addWidget(message)
+            cancel, retry = QPushButton("Cancel", dialog), QPushButton("Try Again", dialog)
+            _set_button_variant(cancel, ControlVariant.SECONDARY.value)
+            _set_button_variant(retry, ControlVariant.PRIMARY.value)
+            cancel.clicked.connect(dialog.reject)
+            retry.clicked.connect(dialog.accept)
+            dialog.footer_layout.addStretch(1)
+            dialog.footer_layout.addWidget(cancel)
+            dialog.footer_layout.addWidget(retry)
+            retry.setDefault(True)
+            dialog.footer.show()
+            accepted = dialog.exec() == QDialog.DialogCode.Accepted
+        finally:
+            dialog.deleteLater()
+        # Let the closed error dialog leave the native window stack before
+        # opening another save panel. Otherwise macOS can return to Anki's
+        # main window when that panel closes, hiding the Garden behind it.
+        if self._dashboard.isVisible():
+            self._dashboard.raise_()
+            self._dashboard.activateWindow()
+        if accepted and self._context is not None:
+            self._retry_timer.start(0)
+        else:
+            self._finish()
+
+    def _finish(self) -> None:
+        self._render_timer.stop()
+        self._retry_timer.stop()
+        self._context = None
+        self._image = None
+        self._destination = ""
+        self._busy = False
+        self._action.setEnabled(True)
+
+    def _dispose(self) -> None:
+        self._disposed = True
+        self._render_timer.stop()
+        self._retry_timer.stop()
+        self._context = None
+        self._image = None
