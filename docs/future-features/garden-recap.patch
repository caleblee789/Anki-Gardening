+"""Keepsake contracts: committed input, portable pixels, and safe local writes."""
+from __future__ import annotations
+
+from copy import deepcopy
+from datetime import date
+import struct
+
+import pytest
+
+
+pytestmark = pytest.mark.release_evidence
+
+
+@pytest.fixture
+def recap(monkeypatch):
+    monkeypatch.setenv("ANKI_GARDEN_SKIP_STARTUP", "1")
+    monkeypatch.setenv("QT_QPA_PLATFORM", "offscreen")
+    pytest.importorskip("aqt.qt")
+    from aqt.qt import QApplication, QEvent
+    from ankigarden.ui import garden_recap
+    app = QApplication.instance() or QApplication([])
+    yield garden_recap
+    app.sendPostedEvents(None, QEvent.Type.DeferredDelete)
+
+
+@pytest.mark.parametrize("year", [2026, 2027])
+def test_snapshot_uses_committed_artwork_and_one_local_date(recap, year):
+    from test_engine import make_engine
+    engine, storage = make_engine()
+    storage.state.garden_name = "PRIVATE GARDEN"
+    storage.state.plants[0].name = "PRIVATE PLANT"
+    before, saves = deepcopy(storage.state.to_dict()), storage.save_count
+    context = recap._capture_recap_context(engine, date(year, 12, 31))
+    assert context.filename == f"anki-garden-recap-{year}.png"
+    assert context.subtitle == f"{year} Year in Review"
+    assert storage.state.to_dict() == before
+    assert storage.save_count == saves
+    assert "PRIVATE" not in repr(context.scene)
+    committed = deepcopy(context.scene)
+    storage.state.plants[0].slot_index = 4
+    storage.state.plants[0].growth_points = 9000
+    storage.state.selected_background = "snowy"
+    assert context.scene == committed
+    assert context.scene["plants"][0]["slot_index"] == 0
+    assert context.scene["plants"][0]["stage"] == "seed"
+    assert context.scene["visible_scenery"] != "snowy"
+
+
+@pytest.mark.parametrize("populated", [False, True])
+def test_encoded_png_is_opaque_fixed_size_and_free_of_metadata(recap, tmp_path, populated):
+    from aqt.qt import QColor, QImage, QPalette, QApplication
+    from test_engine import make_engine
+    from ankigarden.models.state import Plant, GROWTH_THRESHOLDS
+    engine, storage = make_engine()
+    if populated:
+        storage.state.plants = [Plant(f"private-{i}", species, "Private", i, growth_points=GROWTH_THRESHOLDS[-1])
+                                for i, species in enumerate(("sunflower", "foxglove", "wisteria", "japanese_maple", "rose", "bonsai"))]
+        storage.state.unlocked_slots = 6
+    context = recap._capture_recap_context(engine, date(2027, 1, 1))
+    image = recap._render_recap(context)
+    path = tmp_path / "keepsake.png"
+    recap._write_recap(image, str(path))
+    encoded = path.read_bytes()
+    assert encoded[:8] == b"\x89PNG\r\n\x1a\n"
+    chunks, offset = [], 8
+    while offset < len(encoded):
+        length = struct.unpack_from(">I", encoded, offset)[0]
+        chunks.append(encoded[offset + 4:offset + 8])
+        offset += length + 12
+    assert set(chunks) <= {b"IHDR", b"IDAT", b"IEND", b"pHYs", b"sRGB", b"gAMA", b"cHRM"}
+    decoded = QImage(str(path))
+    assert (decoded.width(), decoded.height()) == (1800, 1200)
+    assert not decoded.hasAlphaChannel()
+    assert decoded.textKeys() == []
+    assert decoded.pixelColor(0, 0).name().upper() == "#F6F3EB"
+    assert decoded.pixelColor(1799, 1199) == decoded.pixelColor(0, 0)
+    # A host-theme change must not change any output pixel.
+    app = QApplication.instance()
+    original = app.palette()
+    dark = QPalette(original)
+    dark.setColor(QPalette.ColorRole.Window, QColor("#080808"))
+    dark.setColor(QPalette.ColorRole.WindowText, QColor("#FFFFFF"))
+    try:
+        app.setPalette(dark)
+        assert recap._render_recap(context) == image
+    finally:
+        app.setPalette(original)
+
+
+@pytest.mark.parametrize("existing", [False, True])
+def test_failed_encoding_preserves_destination_and_removes_partial_output(recap, tmp_path, existing):
+    path = tmp_path / "garden.png"
+    original = b"Existing destination must survive"
+    if existing:
+        path.write_bytes(original)
+
+    class FailedImage:
+        def save(self, output, _format):
+            output.write(b"incomplete PNG")
+            return False
+
+    with pytest.raises(OSError):
+        recap._write_recap(FailedImage(), str(path))
+    assert path.read_bytes() == original if existing else not path.exists()
+    assert set(tmp_path.iterdir()) == ({path} if existing else set())
+
+
+def test_cancel_and_write_retry_keep_one_snapshot_and_release_resources(recap, monkeypatch, tmp_path):
+    from concurrent.futures import Future
+    from types import SimpleNamespace
+    from aqt.qt import QAction, QApplication, QDialog, QFileDialog, QImage, QWidget
+    from ankigarden.ui.dashboard import GardenDialog
+    from test_engine import make_engine
+
+    engine, storage = make_engine()
+    before = deepcopy(storage.state.to_dict())
+    tasks, notices, renders = [], [], []
+    destinations = iter([None, str(tmp_path / "first.png"), str(tmp_path / "renamed.png")])
+
+    class SaveDialog(QFileDialog):
+        def exec(self):
+            self.chosen = next(destinations)
+            return QDialog.DialogCode.Accepted if self.chosen else QDialog.DialogCode.Rejected
+
+        def selectedFiles(self):
+            return [self.chosen]
+
+    real_render = recap._render_recap
+
+    def render(context):
+        renders.append(context)
+        return real_render(context)
+
+    monkeypatch.setattr(recap, "QFileDialog", SaveDialog)
+    monkeypatch.setattr(recap, "_render_recap", render)
+    monkeypatch.setattr(GardenDialog, "exec", lambda self: QDialog.DialogCode.Accepted)
+    owner = QWidget()
+    owner.engine = engine
+    owner.toast_region = SimpleNamespace(show_message=notices.append)
+    owner.mw_window = SimpleNamespace(taskman=SimpleNamespace(
+        run_in_background=lambda work, done: tasks.append((work, done))))
+    action = QAction(owner)
+    flow = recap._GardenRecapExport(owner, action)
+    app = QApplication.instance()
+    try:
+        flow.start()  # User cancels the native destination dialog.
+        assert not renders and not tasks and not list(tmp_path.iterdir())
+        assert action.isEnabled() and storage.state.to_dict() == before
+        flow.start()
+        flow.start()  # A second activation must not create another dialog/export.
+        app.processEvents()
+        assert len(renders) == 1 and len(tasks) == 1 and not action.isEnabled()
+        original_image = QImage(flow._image)
+        _work, done = tasks.pop()
+        failure = Future()
+        failure.set_exception(OSError("simulated write failure"))
+        done(failure)
+        # Gameplay may change while the save flow is open. Retry retains the
+        # original image/context rather than exporting that later garden.
+        storage.state.plants[0].slot_index = 5
+        storage.state.selected_background = "snowy"
+        app.processEvents()
+        app.processEvents()
+        assert len(renders) == 1 and len(tasks) == 1
+        work, done = tasks.pop()
+        work()
+        success = Future()
+        success.set_result(None)
+        done(success)
+        assert QImage(str(tmp_path / "renamed.png")) == original_image
+        assert action.isEnabled() and not flow._busy
+        assert flow._context is None and flow._image is None
+        assert notices[-1] == "Garden recap saved."
+    finally:
+        owner.deleteLater()
